  "interactionTests": [
    {
      "testId": "EDGE-14_skip_is_presentation_only",
      "given": "same stage + selected plan with or without animation skip",
      "expected": "same outcome, hero HP, enemy HP, stars, executed cards, and one-time persistence"
    },
    {
      "testId": "EDGE-15_double_submit",
      "given": "start button tapped rapidly multiple times",
      "expected": "one combat result and at most one clearCount increment"
    },
    {
      "testId": "EDGE-16_reload_during_battle",
      "given": "page reload before result screen",
      "expected": "no persisted victory or loss; start from stage-select; no partial combat recovery"
    },
    {
      "testId": "EDGE-17_save_storage_throws",
      "given": "localStorage read/write throws SecurityError or QuotaExceededError",
      "expected": "playable in memory; explicit unsaved-progress warning; no false saved message"
    },
    {
      "testId": "EDGE-18_corrupt_save",
      "given": "truncated or schema-invalid save",
      "expected": "discard invalid records; restore valid records if safely recoverable; no crash; show recovery warning"
    },
    {
      "testId": "EDGE-19_future_save_version",
      "given": "save data created by a newer unsupported saveSchemaVersion",
      "expected": "read-only preservation: do not overwrite original key; session-only play with warning"
    },
    {
      "testId": "EDGE-20_card_not_executed",
      "given": "a 2-turn victory with an unused third selected card",
      "expected": "third card is not in executed history or cardExecuted objective evaluation"
    },
    {
      "testId": "EDGE-21_reduced_motion",
      "given": "system prefers-reduced-motion or player setting",
      "expected": "no essential animation; full logs and results remain accessible"
    },
    {
      "testId": "EDGE-22_save_monotonicity",
      "given": "a later 1-star clear after a 3-star clear, or a hint-aided clear after no-hint clear",
      "expected": "maxStars and bestNoHintStars must not decrease; clearCount increments once per completed win"
    },
    {
      "testId": "EDGE-23_ruleset_migration",
      "given": "an older rulesetVersion under known schema and existing best stars",
      "expected": "do not silently reset prior achievements; follow approved migration policy or protect original save"
    },
    {
      "testId": "EDGE-24_two_tabs",
      "given": "two tabs update the same save nearly simultaneously",
      "expected": "no silent regression of stars or no-hint clear; if not supported, detect/warn and prevent unsafe overwrite"
    }
  ],
  "reference": "INHERITED_V07_COMBAT_BOUNDARY_CASES_RECHECKED_WITH_V08_DESIGN_CALCULATOR"
}
