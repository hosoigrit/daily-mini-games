      "kind": "attack",
      "damageType": "physical",
      "baseDamage": 4,
      "consumesFocus": true,
      "description": "敵に物理4ダメージ。気合がある場合は+4。"
    },
    "magic": {
      "name": "魔法弾",
      "kind": "attack",
      "damageType": "magic",
      "baseDamage": 3,
      "consumesFocus": false,
      "description": "敵に魔法3ダメージ。物理防御では軽減されない。"
    },
    "guard": {
      "name": "ガード",
      "kind": "defense",
      "attackReduction": 5,
      "durationTurns": 1,
      "description": "このターンの敵攻撃ダメージを5軽減。"
    },
    "focus": {
      "name": "気合",
      "kind": "buff",
      "nextSlashBonus": 4,
      "description": "次に実行する斬撃の物理ダメージを+4。魔法弾では消費しない。"
    },
    "heal": {
      "name": "回復",
      "kind": "heal",
      "healAmount": 3,
      "clampToMaxHp": true,
      "description": "勇者HPを最大HPまでの範囲で3回復。"
    },
    "counter": {
      "name": "カウンター",
      "kind": "counter",
      "attackReduction": 3,
      "retaliationDamage": 2,
      "retaliationType": "direct",
      "description": "敵の攻撃を3軽減。攻撃を受けて生存したら、ダメージが0でも反撃2。防御行動には反撃しない。"
    }
  },
  "enemyActionCatalog": {
    "attack": {
      "description": "設定したpowerで勇者を攻撃する。勇者カードによる攻撃軽減を適用。",
      "requiresPower": true
    },
    "physicalGuard": {
      "description": "このターンの勇者の物理ダメージを3軽減。敵は攻撃しない。",
      "physicalReduction": 3,
      "attacks": false
    },
    "magicWard": {
      "description": "このターンの勇者の魔法ダメージを2軽減。敵は攻撃しない。",
      "magicReduction": 2,
      "attacks": false
    }
  },
  "passiveCatalog": {
    "thornArmor": {
      "description": "斬撃が1以上のダメージを与えて敵が生存した場合、勇者に1ダメージ。斬撃で撃破した場合は反動なし。反撃と魔法弾では不発。",
      "damage": 1
    }
  },
  "combatRules": {
    "handSize": 5,
    "planSize": 3,
    "maxTurns": 3,
