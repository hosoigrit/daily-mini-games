      "enemySurvivesAfterTurn3"
    ],
    "healingCap": "heroMaxHp",
    "damageFloor": 0,
    "focusPersistence": "untilNextExecutedSlashOrCombatEnds",
    "thornTrigger": "onExecutedSlashWithPositiveFinalDamageIfEnemyStillAlive",
    "counterTrigger": "enemyAttackActionOccurredAndHeroAliveEvenIfAttackDamageZero",
    "counterDamageType": "direct_ignores_defense_and_thorn",
    "turnOrder": [
